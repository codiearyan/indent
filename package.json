{
  "name": "indent",
  "private": true,
  "description": "A local-first desktop app for hands-on coding labs",
  "author": "Aryan Bhati",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "pnpm --filter @indent/desktop dev",
    "dev:site": "pnpm --filter @indent/site dev",
    "build": "pnpm --filter @indent/desktop build",
    "build:site": "pnpm --filter @indent/site build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint --cache .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.10"
  },
  "packageManager": "pnpm@11.5.2"
}
