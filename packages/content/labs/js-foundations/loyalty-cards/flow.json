      "steps": [
        {
          "active": ["customer", "customer->stamp", "stamp"],
          "value": {
            "kind": "map",
            "label": "a new card",
            "entries": [
              { "key": "goal", "value": 10 },
              { "key": "stamps()", "value": 0 }
            ]
          },
          "note": "Ines makes a card for a customer. Ten stamps and the next candle is free."
        },
        {
          "active": ["customer", "customer->stamp", "stamp"],
          "value": {
            "kind": "map",
            "label": "after the first purchase",
            "entries": [
              { "key": "stamp()", "value": "false" },
              { "key": "stamps()", "value": 1 }
            ]
          },
          "note": "Each purchase calls stamp(). The card holds one stamp now, and it is not time for a reward."
