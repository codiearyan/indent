              { "key": "stamps()", "value": 0 }
            ]
          },
          "note": "The tenth stamp reaches the goal: a free candle, and the card starts again from 0."
        },
        {
          "active": ["customer", "stamp"],
          "note": "Another customer's card keeps its own count. Stamping one card never changes another."
        }
      ]
