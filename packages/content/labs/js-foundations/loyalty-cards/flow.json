        {
          "active": ["memo", "memo->slow", "slow"],
          "value": {
            "kind": "map",
            "label": "saved answers",
            "entries": [{ "key": "cedar", "value": 40 }]
          },
          "note": "So the slow burnHours() works it out, and the answer is saved under 'cedar'."
        },
        {
          "active": ["guide", "guide->memo", "memo"],
          "value": {
            "kind": "map",
            "label": "saved answers",
            "entries": [{ "key": "cedar", "value": 40 }]
          },
          "note": "The guide asks for 'cedar' again. The saved answer comes straight back, and burnHours() is not called."
        },
        {
          "active": ["memo", "memo->slow", "slow"],
          "value": {
            "kind": "map",
            "label": "saved answers",
            "entries": [
              { "key": "cedar", "value": 40 },
              { "key": "birch", "value": 60 }
            ]
          },
          "note": "'birch' is new, so burnHours() runs once more. The number 1 and the text '1' would be two different keys."
        }
      ]
    },
    "once": {
      "steps": [
        {
          "active": ["button", "button->once", "once"],
          "note": "A customer clicks the welcome button, and the wrapper is called with 'Ines'."
        },
        {
          "active": ["once", "once->email", "email"],
          "value": {
            "kind": "array",
            "label": "emails sent",
            "values": ["Ines"]
          },
          "note": "It is the first call, so the email function runs with the same arguments, and what it returns is kept."
        },
        {
          "active": ["button", "button->once", "once"],
          "value": {
            "kind": "array",
            "label": "emails sent",
            "values": ["Ines"]
          },
          "note": "The customer clicks again, this time with 'Theo'. The email function is not called."
        },
        {
          "active": ["once"],
          "note": "Every later call hands back the first result, whatever arguments it gets. That holds even when the first result was undefined."
        }
