        {
          "active": ["stamp"],
          "value": {
            "kind": "map",
            "label": "after nine purchases",
            "entries": [{ "key": "stamps()", "value": 9 }]
          },
          "note": "The count lives on between calls. Nine purchases later the card is one stamp away."
        },
        {
          "active": ["stamp", "stamp->reward", "reward"],
          "value": {
            "kind": "map",
            "label": "after the tenth purchase",
            "entries": [
