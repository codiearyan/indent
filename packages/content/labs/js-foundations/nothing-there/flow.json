      ]
    },
    "note": {
      "steps": [
        {
          "active": ["form", "form->note"],
          "value": {
            "kind": "map",
            "label": "from the form",
            "entries": [{ "key": "giftNote", "value": "null" }]
          },
          "note": "The customer left the note box empty, so it arrives as null."
        },
        {
          "active": ["note"],
          "note": "When nothing is there at all, a default text steps in."
        },
        {
          "active": ["note", "note->theo", "theo"],
          "note": "A note that is empty text was still sent, so it is kept as it is."
        }
      ]
    },
    "extra": {
      "steps": [
        {
          "active": ["form", "form->extra"],
          "value": {
            "kind": "map",
            "label": "from the form",
