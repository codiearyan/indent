          "value": {
            "kind": "map",
            "label": "when quantity is",
            "entries": [
              { "key": "a real number", "value": "kept" },
              { "key": "NaN or 0", "value": "one candle" }
            ]
          },
          "note": "When the quantity is NaN or 0, Theo counts the order as one candle."
        },
        {
          "active": ["safe", "safe->theo", "theo"],
