    "to-cents": {
      "trace": { "file": "src/price.ts", "call": "toCents", "args": [" 24.90 "] },
      "steps": [
        {
          "active": ["form", "form->price"],
          "value": {
            "kind": "map",
            "label": "what the form sends",
            "entries": [
              { "key": "typed", "value": "' 24.90 '" },
              { "key": "or", "value": "a number of euros" }
            ]
          },
          "note": "A customer typed ' 24.90 ' into the price box. The old form can also send a plain number of euros."
        },
        {
          "active": ["price"],
          "note": "The parameter is a number or a string. typeof splits the two, and inside the number branch TypeScript knows amount is a number."
        },
        {
          "active": ["price"],
          "note": "A number is euros. A negative one, or one that is not finite, is not a price."
        },
        {
          "active": ["price"],
          "value": { "kind": "array", "label": "text that is a price", "values": ["24", "24.9", "24.90"] },
          "note": "Text is trimmed first. After the number branch returns, amount is a string, so trim is allowed. Digits with an optional dot and one or two decimals count."
        },
        {
          "active": ["price", "price->page", "page"],
          "value": {
            "kind": "map",
            "label": "what comes back",
            "entries": [{ "key": "price", "value": "whole cents, or null" }]
          },
          "note": "The page gets whole cents, or null when the input is not a price. The return type says both, so no caller can forget the null."
        }
      ]
    },
