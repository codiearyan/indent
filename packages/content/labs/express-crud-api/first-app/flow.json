          "note": "Ivo's page asks whether the API is running."
        },
        {
          "active": ["routes", "routes->reply", "reply", "reply->page"],
          "value": {
            "kind": "map",
            "label": "what goes back",
            "entries": [
              { "key": "status", "value": 200 },
              { "key": "body", "value": "a small object with a status" }
