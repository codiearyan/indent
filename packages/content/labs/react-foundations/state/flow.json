        { "active": ["counter", "counter->state", "state"], "value": { "kind": "map", "label": "Remembered", "entries": [{ "key": "inside", "value": "number" }] }, "note": "React keeps the new count for the component." },
        { "active": ["state", "state->screen", "screen"], "note": "The screen is drawn again and shows it at once." }
      ]
    },
    "out": {
      "steps": [
        { "active": ["volunteer", "volunteer->buttons", "buttons"], "note": "A visitor leaves and the volunteer presses Out." },
        { "active": ["buttons", "buttons->counter", "counter", "counter->state", "state"], "note": "The count goes down by one, unless nobody is inside." },
        { "active": ["state", "state->screen", "screen"], "note": "The screen never shows fewer than nobody." }
      ]
    },
    "family": {
      "steps": [
        { "active": ["volunteer", "volunteer->buttons", "buttons"], "note": "A family of four comes in on one ticket." },
        { "active": ["buttons", "buttons->counter", "counter"], "note": "One press asks for a visitor four times over." },
        { "active": ["counter", "counter->state", "state"], "note": "Each ask starts from the count the one before it left." },
        { "active": ["state", "state->screen", "screen"], "note": "All four of them are counted." }
      ]
    },
    "doors": {
      "steps": [
