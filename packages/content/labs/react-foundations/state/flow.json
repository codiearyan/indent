        { "active": ["counter", "counter->state", "state"], "value": { "kind": "map", "label": "Remembered", "entries": [{ "key": "inside", "value": "number" }, { "key": "open", "value": "true or false" }] }, "note": "The doors are a second value, kept apart from the count." },
        { "active": ["state", "state->screen", "screen"], "note": "The screen says the doors are closed, and nobody more is let in." }
