---
import { getImage } from 'astro:assets'
import logo from '@indent/design/logo.png'
import tokens from '@indent/design/tokens.css?raw'
import share from '../assets/share.png'
import '../styles/global.css'

interface Props {
  title: string
  description: string
}

const { title, description } = Astro.props
const icon = await getImage({ src: logo, width: 64, height: 64, format: 'png' })
// iOS fills transparent corners with white, so the touch icon sits on the dark --background.
const ground = tokens.match(/--ink-900:\s*(#[0-9a-f]+)/i)?.[1]
if (!ground) throw new Error('tokens.css has no --ink-900')
const touchIcon = await getImage({ src: logo, format: 'png', background: ground, width: 180, height: 180 })
const shareImage = await getImage({ src: share, width: 1200, height: 630, format: 'jpg', quality: 85 })
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL(shareImage.src, Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Indent: learn to code by fixing real problems. tryindent.in" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" href={icon.src} />
    <link rel="apple-touch-icon" href={touchIcon.src} />
  </head>
  <body class="bg-background text-[15px] text-foreground">
    <a
      href="#main"
      class="sr-only rounded-md bg-foreground px-3 py-2 text-background focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50"
    >
      Skip to content
    </a>
    <slot />
  </body>
</html>
