---
import Layout from '../layouts/Layout.astro'
import Nav from '../components/Nav.astro'
import Hero from '../components/Hero.astro'
import How from '../components/How.astro'
import Providers from '../components/Providers.astro'
import Steps from '../components/Steps.astro'
import LocalFirst from '../components/LocalFirst.astro'
import Extras from '../components/Extras.astro'
import Faq from '../components/Faq.astro'
import Closing from '../components/Closing.astro'
import { listRepos } from '../lib/content'
import { RELEASES_URL, VERSION } from '../lib/downloads'

const repos = listRepos().sort(
  (a, b) => a.category.localeCompare(b.category) || a.title.localeCompare(b.title)
)
const description = `A desktop app for learning to code: ${repos.length} hands-on repos in JavaScript, TypeScript, Python, SQL, Java and C++, checked by hidden tests. Free for personal use.`
const site = Astro.site!.href
// What search engines read about the app; every field is also on the page.
const structured = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `${site}#website`, name: 'Indent', url: site },
    {
      '@type': 'SoftwareApplication',
      name: 'Indent',
      url: site,
      description,
      applicationCategory: 'EducationalApplication',
      operatingSystem: 'macOS, Windows, Linux',
      softwareVersion: VERSION,
      downloadUrl: RELEASES_URL,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }
    }
  ]
}
---

<Layout title="Indent: learn to code by fixing real problems" description={description}>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(structured)} />
  <Nav />
  <main id="main">
    <Hero />
    <How repos={repos} />
    <Providers />
    <Steps />
    <Extras repos={repos} />
    <LocalFirst />
    <Faq />
  </main>
  <Closing />
</Layout>
