---
import { Image } from 'astro:assets'
import logo from '@indent/design/logo.png'
import Download from '@lucide/astro/icons/download'
import { DOWNLOADS, REPO_URL, SPONSOR_URL, VERSION } from '../lib/downloads'

const links = [
  { href: '#repos', label: 'Repos' },
  { href: '#story', label: 'Story' },
  { href: '#how', label: 'How it works' },
  { href: '#help', label: 'Hints and tutor' },
  { href: '#local', label: 'Local first' },
  { href: '#patterns', label: 'Patterns' },
  { href: '#roadmaps', label: 'Roadmaps' },
  { href: '#activity', label: 'Activity' },
  { href: '#faq', label: 'FAQ' }
]
const requirements = [
  { label: 'Version', value: VERSION },
  { label: 'System', value: 'macOS, Windows or Linux' },
  { label: 'Node.js', value: '22.18 or newer, or Indent downloads it' }
]
---

<section id="run" aria-labelledby="run-title" class="scroll-mt-8 border-t border-rule pt-28 sm:pt-40">
  <div class="wrap">
    <h2 id="run-title" class="display max-w-[1100px] text-[44px] text-balance sm:text-[72px] lg:text-[96px]">
      <span class="text-muted-foreground">Pick a repo.</span>{' '}
      <span>Fix the first issue tonight.</span>
    </h2>

    <div class="mt-16 grid overflow-hidden rounded-lg border border-border lg:grid-cols-12">
      <div class="p-6 sm:p-10 lg:col-span-5">
        <h3 class="text-[22px] font-medium tracking-[-0.015em]">Download Indent</h3>
        <p class="mt-3 max-w-[420px] text-[16px] leading-[1.6] text-muted-foreground">
          One installer, nothing to sign up for. Indent runs your code and the checks with Node, and
          the first Check downloads the test tools once, into your work folder.
        </p>
        <dl class="mt-8">
          {
            requirements.map((item) => (
              <div class="flex items-center justify-between gap-4 border-t border-rule py-3.5 text-[14px]">
                <dt class="text-muted-foreground">{item.label}</dt>
                <dd class="text-right">{item.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <div class="border-t border-border bg-card p-6 sm:p-10 lg:col-span-7 lg:border-t-0 lg:border-l">
        <ul>
          {
            DOWNLOADS.map((download) => (
              <li class="flex items-center justify-between gap-4 border-b border-rule py-4 first:pt-0">
                <div class="flex items-center gap-4">
                  <svg class="size-5 shrink-0 text-muted-foreground" fill="currentColor" aria-hidden="true">
                    <use href={`#os-${download.os}`} />
                  </svg>
                  <div>
                    <p class="text-[16px] font-medium">{download.label}</p>
                    <p class="mt-0.5 text-[14px] text-muted-foreground">{download.note}</p>
                  </div>
                </div>
                <a
                  href={download.href}
                  class="inline-flex h-10 shrink-0 items-center gap-2 rounded-full border border-input px-4 text-[14px] font-medium transition-colors hover:bg-accent"
                >
                  <Download class="size-4" stroke-width={2} aria-hidden="true" />
                  Download
                  <span class="sr-only">for {download.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <p class="mt-6 text-[14px] leading-[1.6] text-muted-foreground">
          The macOS apps are signed and notarized by Apple. The Windows installer is not signed yet,
          so its first open needs one extra step: choose More info, then Run anyway.
        </p>
        <p class="mt-3 text-[14px] leading-[1.6] text-muted-foreground">
          Or build it yourself from the{' '}
          <a
            href={REPO_URL}
            class="text-foreground underline decoration-border underline-offset-4 hover:decoration-foreground"
          >
            source on GitHub
          </a>.
        </p>
      </div>
    </div>
  </div>
</section>

<footer class="mt-28 overflow-hidden sm:mt-40">
  <div class="wrap">
    <div class="flex flex-col gap-8 border-t border-rule py-10 sm:flex-row sm:items-center sm:justify-between">
      <a href="#top" class="flex items-center gap-2.5 rounded-md" aria-label="Indent, back to top">
        <Image src={logo} alt="" width={48} height={48} class="size-6 rounded-[5px]" />
        <span class="text-[15px] font-semibold">Indent</span>
        <span class="text-[14px] text-muted-foreground">Learn by fixing real problems.</span>
      </a>
      <nav aria-label="Footer" class="flex flex-wrap gap-x-6 gap-y-2">
        {
          links.map((link) => (
            <a href={link.href} class="text-[14px] text-muted-foreground hover:text-foreground">
              {link.label}
            </a>
          ))
        }
        <a href={SPONSOR_URL} class="text-[14px] text-muted-foreground hover:text-foreground">
          Sponsor
        </a>
      </nav>
    </div>
  </div>
  <div
    class="relative overflow-hidden text-foreground select-none after:absolute after:bottom-0 after:h-px after:w-full after:bg-current/15"
    data-fluid-word
    aria-hidden="true"
  >
    <svg class="w-full translate-y-[37.5%]" viewBox="0 0 1200 300" fill="none">
      <text
        x="50%"
        y="50%"
        text-anchor="middle"
        dominant-baseline="central"
        stroke="currentColor"
        stroke-opacity="0.1"
        stroke-width="2"
        fill="url(#fluid-word-fill)"
        font-size="300"
        font-weight="600"
        letter-spacing="-0.04em"
      >
        Indent
      </text>
      <defs>
        <linearGradient
          id="fluid-word-fill"
          x1="600"
          y1="0"
          x2="600"
          y2="300"
          gradientUnits="userSpaceOnUse"
        >
          <stop offset="0.625" style="stop-color: var(--brand)" stop-opacity="0"></stop>
          <stop offset="1" style="stop-color: var(--brand)"></stop>
        </linearGradient>
      </defs>
    </svg>
  </div>
</footer>

<script>
  // The fill's starting point follows the pointer on a spring, so the gradient leans toward it.
  const word = document.querySelector<HTMLElement>('[data-fluid-word]')
  const fill = word?.querySelector('linearGradient')
  if (word && fill && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const rest = 600
    let target = rest
    let x = rest
    let speed = 0
    let frame = 0
    const step = (): void => {
      speed = (speed + (target - x) * 0.08) * 0.75
      x += speed
      fill.setAttribute('x1', String(x))
      const moving = Math.abs(target - x) > 0.5 || Math.abs(speed) > 0.5
      frame = moving ? requestAnimationFrame(step) : 0
    }
    const aim = (to: number): void => {
      target = to
      if (!frame) frame = requestAnimationFrame(step)
    }
    const follow = (event: PointerEvent): void => {
      const box = word.getBoundingClientRect()
      aim(((event.clientX - box.left) / box.width) * 1200)
    }
    word.addEventListener('pointermove', follow)
    word.addEventListener('pointerdown', follow)
    word.addEventListener('pointerleave', () => aim(rest))
  }
</script>
