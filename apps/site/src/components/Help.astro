---
import Check from '@lucide/astro/icons/check'
import X from '@lucide/astro/icons/x'
import Lock from '@lucide/astro/icons/lock'
import SquareTerminal from '@lucide/astro/icons/square-terminal'
import KeyRound from '@lucide/astro/icons/key-round'
import { readTask } from '../lib/content'
import SectionHead from './SectionHead.astro'

const task = readTask('node-api', 'first-routes', 'not-found')
const checks = [
  { name: 'An unknown path answers 404 not_found', passed: true },
  { name: 'The 404 error has a message', passed: true },
  { name: 'A wrong method answers 405 method_not_allowed', passed: false },
  { name: 'The 405 lists the allowed methods', passed: false }
]
const tools = [
  { name: 'Claude Code', command: 'claude' },
  { name: 'Codex', command: 'codex' },
  { name: 'OpenCode', command: 'opencode' },
  { name: 'Gemini CLI', command: 'gemini' }
]
const code = (text: string): string =>
  text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/`([^`]+)`/g, '<code class="rounded-sm bg-accent px-1 py-0.5 font-mono text-[0.88em] text-foreground">$1</code>')
---

<section id="help" aria-labelledby="help-title" class="scroll-mt-8 border-t border-rule py-28 sm:py-40">
  <div class="wrap">
    <SectionHead
      id="help-title"
      label="/help"
      step={3}
      muted="Stuck is part of it."
      bright="Help that does not hand you"
      accent="the answer."
    >
      <p>
        Check messages say what to look at, never what to type. When that is not enough, hints open
        one at a time, and a tutor can talk it through with you.
      </p>
    </SectionHead>

    <div
      class="mt-16 grid gap-px overflow-hidden rounded-lg border border-border bg-border lg:grid-cols-2"
    >
      <article class="flex flex-col bg-background p-6 sm:p-10">
        <h3 class="text-[22px] font-medium tracking-[-0.015em]">Three hints per task</h3>
        <p class="mt-3 max-w-[460px] text-[16px] leading-[1.6] text-muted-foreground">
          The first hint opens after three checks that are not all green, then one more with each
          check. They go from a nudge to almost there.
        </p>

        <div class="mt-10 rounded-lg border border-border bg-card">
          <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 border-b border-rule px-5 py-4">
            <p class="text-[14px] font-semibold">3. {task.title}</p>
            <p class="font-mono text-[12px] text-muted-foreground">3 checks, not all green</p>
          </div>
          <ul class="px-5 py-2">
            {
              checks.map((check) => (
                <li class="flex items-center gap-3 py-2 text-[14px]">
                  {check.passed ? (
                    <Check class="size-4 shrink-0 text-success" stroke-width={2} aria-label="Passed" />
                  ) : (
                    <X class="size-4 shrink-0 text-destructive" stroke-width={2} aria-label="Not yet" />
                  )}
                  <span class:list={[!check.passed && 'text-muted-foreground']}>{check.name}</span>
                </li>
              ))
            }
          </ul>
          <ol class="border-t border-rule">
            {
              task.hints.map((hint, i) => (
                <li class="flex gap-4 border-b border-rule px-5 py-4 last:border-b-0">
                  <span class="w-12 shrink-0 font-mono text-[12px] leading-6 text-muted-foreground">
                    Hint {i + 1}
                  </span>
                  {i === 0 ? (
                    <p class="text-[14px] leading-6" set:html={code(hint)} />
                  ) : (
                    <p class="flex items-center gap-2 text-[14px] leading-6 text-muted-foreground">
                      <Lock class="size-3.5" stroke-width={1.5} aria-hidden="true" />
                      {i === 1 ? 'Opens with your next check' : 'Opens with the check after that'}
                    </p>
                  )}
                </li>
              ))
            }
          </ol>
        </div>
        <p class="mt-4 text-[13px] text-muted-foreground">
          A real task and its first hint, from the repo Build a JSON API with Node.
        </p>
      </article>

      <article class="flex flex-col bg-background p-6 sm:p-10">
        <h3 class="text-[22px] font-medium tracking-[-0.015em]">A tutor that knows the issue</h3>
        <p class="mt-3 max-w-[460px] text-[16px] leading-[1.6] text-muted-foreground">
          A chat on the side of the workspace that knows the issue you are on. Ask in plain words;
          it explains rather than answers. It runs on a coding CLI you already have installed, or on
          your own API key.
        </p>

        <ul class="mt-10 rounded-lg border border-border bg-card">
          {
            tools.map((tool) => (
              <li class="flex h-14 items-center gap-3 border-b border-rule px-5">
                <SquareTerminal class="size-4 text-muted-foreground" stroke-width={1.5} aria-hidden="true" />
                <span class="text-[15px]">{tool.name}</span>
                <span class="ml-auto font-mono text-[12px] text-muted-foreground">{tool.command}</span>
              </li>
            ))
          }
          <li class="flex h-14 items-center gap-3 border-b border-rule px-5">
            <KeyRound class="size-4 text-muted-foreground" stroke-width={1.5} aria-hidden="true" />
            <span class="text-[15px]">Your own API key</span>
            <span class="ml-auto hidden text-[13px] text-muted-foreground sm:inline">Anthropic, OpenAI or Gemini</span>
          </li>
          <li class="flex min-h-14 items-center gap-3 px-5 py-2">
            <span class="flex flex-col">
              <span class="text-[15px]">Inline suggestions</span>
              <span class="text-[13px] text-muted-foreground">Off by default</span>
            </span>
            <span
              class="relative ml-auto h-5 w-9 rounded-full border border-input bg-accent"
              role="img"
              aria-label="Switch, off"
            >
              <span class="absolute top-0.5 left-0.5 size-3.5 rounded-full bg-muted-foreground"></span>
            </span>
          </li>
        </ul>
        <p class="mt-4 text-[13px] text-muted-foreground">
          No sign-in to Indent. The tutor uses what you already have.
        </p>
      </article>
    </div>
  </div>
</section>
