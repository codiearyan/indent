---
import Check from '@lucide/astro/icons/check'
import X from '@lucide/astro/icons/x'
import type { Repo } from '../lib/content'
import { readIntro } from '../lib/content'
import SectionHead from './SectionHead.astro'

interface Props {
  repos: Repo[]
}

const { repos } = Astro.props
const intro = readIntro('js-bug-hunts', 'cent-off-totals')
const repo = repos.find((r) => r.id === 'js-bug-hunts')
const frames = ['The ask', 'The problem', 'Your part', 'Done', 'The whole trip']
const bugHunts = repos.filter((r) => r.kind === 'bug-hunt').length
const cells = [
  {
    title: 'A story before every issue',
    body: 'About eleven seconds, before you read a word: who asks, what goes wrong today, which part is yours and what right looks like. It plays once, then waits on its last frame with Replay.'
  },
  {
    title: 'See the flow',
    body: 'Each issue has a scene of the files and functions it touches. Under every task, See the flow plays the steps your code has to take through it.'
  },
  {
    title: 'Trace my code',
    body: 'Runs the task’s example through your own functions and lays the calls over the flow, so you see where your code left the path, in plain words and without the answer.'
  },
  {
    title: `${bugHunts} bug hunts, like an interview`,
    body: 'You get code someone else wrote and a bug report. Reproduce it, fix the cause and write the test that would have caught it, the way a live interview asks.'
  }
]
---

<section id="story" aria-labelledby="story-title" class="scroll-mt-8 border-t border-rule py-28 sm:py-40">
  <div class="wrap">
    <SectionHead
      id="story-title"
      label="/story"
      step={2}
      muted="Dropped into a codebase."
      bright="Like day one at a new job, or a"
      accent="live interview."
    >
      <p>
        Every issue starts with someone who has a problem. A short animated intro tells the story,
        then you open code you did not write and make it right.
      </p>
    </SectionHead>

    <figure class="mt-16 rounded-lg border border-border bg-card">
      <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3 border-b border-rule px-5 py-4 sm:px-6">
        <p class="text-[14px] font-semibold">
          {repo?.title}, issue 1 of {repo?.issues.length}
        </p>
        <p class="flex h-7 items-center gap-2 rounded-sm border border-border px-2.5 text-[13px]">
          <span class="text-muted-foreground">{intro.ticket.label}</span>
          <span class="grid">
            <span class="ticket-wrong flex items-center gap-1.5 [grid-area:1/1]">
              <X class="size-3.5 text-destructive" stroke-width={2} aria-hidden="true" />
              {intro.ticket.wrong}
            </span>
            <span class="ticket-right flex items-center gap-1.5 [grid-area:1/1]">
              <Check class="size-3.5 text-success" stroke-width={2} aria-hidden="true" />
              {intro.ticket.right}
            </span>
          </span>
        </p>
      </div>

      <ol class="grid gap-px bg-rule md:grid-cols-2 lg:grid-cols-4">
        {
          intro.stations.map((station) => (
            <li class:list={['flex flex-col gap-3 bg-card p-5 sm:p-6', station.mine && 'mine']}>
              <div class="flex items-center justify-between gap-3">
                <p class="text-[13px] text-muted-foreground">{station.title}</p>
                {station.mine && (
                  <span class="rounded-sm bg-primary px-1.5 py-0.5 text-[12px] font-medium text-primary-foreground">
                    Your part
                  </span>
                )}
              </div>
              {station.say && (
                <p class="rounded-md border border-border px-3 py-2 text-[15px]">“{station.say}”</p>
              )}
              {station.text && <p class="text-[15px]">{station.text}</p>}
              {station.rows && (
                <table class="w-full text-[14px]">
                  <tbody>
                    {station.rows.map((row) => (
                      <tr class="border-b border-rule last:border-b-0">
                        <td class="py-1.5">{row[0]}</td>
                        <td class="py-1.5 text-right font-mono text-[13px] tabular-nums">{row[1]}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              )}
              {station.mine && (
                <div class="flex flex-col gap-2">
                  <p class="font-mono text-[13px]">{station.file}</p>
                  <p class="rounded-md border border-dashed border-input px-3 py-2 text-[14px] text-muted-foreground">
                    {station.gap}
                  </p>
                  <ul class="flex flex-col gap-1 text-[14px]">
                    {station.tasks?.map((task, i) => (
                      <li class="flex gap-2">
                        <span class="font-mono text-[12px] leading-5 text-muted-foreground">{i + 1}</span>
                        {task}
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {station.note && <p class="mt-auto text-[12px] text-muted-foreground">{station.note}</p>}
            </li>
          ))
        }
      </ol>

      <ol class="grid border-t border-rule lg:grid-cols-5">
        {
          intro.captions.map((caption, i) => (
            <li
              class="beat flex flex-col gap-2 border-rule px-5 py-4 not-last:border-b lg:not-last:border-r lg:not-last:border-b-0"
              style={`--beat: ${i}`}
            >
              <span class="beat-cell h-1 w-6 rounded-full bg-accent" aria-hidden="true"></span>
              <span class="font-mono text-[12px] text-muted-foreground">{frames[i]}</span>
              <span class="beat-text text-[14px] leading-[1.5]">{caption}</span>
            </li>
          ))
        }
      </ol>
      <figcaption class="sr-only">
        The intro of the first issue of {repo?.title}, frame by frame.
      </figcaption>
    </figure>
    <p class="mt-4 text-[13px] text-muted-foreground">
      The real intro of an issue, from the repo {repo?.title}. In the app it plays as an animation.
    </p>

    <ul class="mt-6 grid gap-px overflow-hidden rounded-lg border border-border bg-border md:grid-cols-2">
      {
        cells.map((cell) => (
          <li class="bg-background p-7 sm:p-10">
            <h3 class="text-[22px] font-medium tracking-[-0.015em]">{cell.title}</h3>
            <p class="mt-3 max-w-[480px] text-[16px] leading-[1.65] text-muted-foreground">{cell.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Five frames over eleven seconds, like the intro in the app: each caption has its turn. */
  .beat-text {
    color: var(--muted-foreground);
    animation: beat-text 11s var(--ease-out) calc(var(--beat) * 2.2s) infinite;
  }
  .beat-cell {
    animation: beat-cell 11s var(--ease-out) calc(var(--beat) * 2.2s) infinite;
  }
  @keyframes beat-text {
    0%,
    20% {
      color: var(--foreground);
    }
    22%,
    100% {
      color: var(--muted-foreground);
    }
  }
  @keyframes beat-cell {
    0%,
    20% {
      background-color: var(--brand);
    }
    22%,
    100% {
      background-color: var(--accent);
    }
  }
  /* The ticket ends wrong for the first three frames and right from Done on. */
  .ticket-right {
    opacity: 0;
    animation: ticket-right 11s var(--ease-out) infinite;
  }
  .ticket-wrong {
    animation: ticket-wrong 11s var(--ease-out) infinite;
  }
  @keyframes ticket-wrong {
    0%,
    58% {
      opacity: 1;
    }
    61%,
    100% {
      opacity: 0;
    }
  }
  @keyframes ticket-right {
    0%,
    58% {
      opacity: 0;
    }
    61%,
    100% {
      opacity: 1;
    }
  }
  .mine {
    box-shadow: inset 0 2px 0 var(--brand);
  }
  @media (prefers-reduced-motion: reduce) {
    .beat-text,
    .beat-cell,
    .ticket-right,
    .ticket-wrong {
      animation: none;
    }
    .ticket-wrong {
      opacity: 0;
    }
    .beat-text {
      color: var(--foreground);
    }
    .ticket-right {
      opacity: 1;
    }
  }
</style>
