---
import type { AiProviderId } from '../../../desktop/src/shared/types'
import { PROVIDER_MARKS } from '../../../desktop/src/shared/providerMarks'

interface Props {
  id: AiProviderId
  class?: string
}

const { id, class: className } = Astro.props
const mark = PROVIDER_MARKS[id]
const gradientId = `mark-${id}-${Math.random().toString(36).slice(2, 8)}`
const fill = mark.gradient ? `url(#${gradientId})` : (mark.color ?? 'currentColor')
---

<svg viewBox="0 0 24 24" fill-rule="evenodd" aria-hidden="true" class:list={['shrink-0', className]}>
  {
    mark.gradient && (
      <defs>
        <linearGradient id={gradientId} x1="0" y1="0" x2="1" y2="1">
          {mark.gradient.map((stop, i, stops) => (
            <stop offset={i / (stops.length - 1)} stop-color={stop} />
          ))}
        </linearGradient>
      </defs>
    )
  }
  <path d={mark.d} fill={fill}></path>
</svg>
