---
import { Image } from 'astro:assets'
import logo from '@indent/design/logo.png'
import { REPO_URL } from '../lib/downloads'

const links = [
  { href: '#how', label: 'How' },
  { href: '#ai', label: 'Your AI' },
  { href: '#roadmaps', label: 'Roadmaps' },
  { href: '#local', label: 'Local first' },
  // { href: '#patterns', label: 'Patterns' },
  { href: '#faq', label: 'FAQ' }
]
---

<header class="absolute inset-x-0 top-0 z-20">
  <div class="wrap flex h-20 items-center justify-between gap-4">
    <a href="#top" class="flex items-center gap-2.5 rounded-md" aria-label="Indent, back to top">
      <Image src={logo} alt="" width={56} height={56} class="size-7 rounded-md" loading="eager" />
      <span class="text-[17px] font-semibold tracking-[-0.01em]">Indent</span>
    </a>
    <nav
      aria-label="Sections"
      class="absolute left-1/2 hidden h-11 -translate-x-1/2 items-center rounded-full border border-border bg-background px-1.5 lg:flex"
    >
      {
        links.map((link) => (
          <a
            href={link.href}
            class="rounded-full px-4 py-1.5 text-[14px] text-muted-foreground transition-colors hover:bg-accent hover:text-foreground"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="flex items-center gap-2">
      <details class="nav-menu relative lg:hidden">
        <summary
          class="inline-flex h-9 cursor-pointer items-center rounded-full border border-border px-4 text-[14px] text-muted-foreground hover:text-foreground"
        >
          Menu
        </summary>
        <nav
          aria-label="Sections"
          class="absolute right-0 mt-2 w-52 rounded-lg border border-border bg-popover p-1.5 shadow-2xl"
        >
          {
            links.map((link) => (
              <a
                href={link.href}
                class="block rounded-md px-3 py-2.5 text-[14px] text-muted-foreground hover:bg-accent hover:text-foreground"
              >
                {link.label}
              </a>
            ))
          }
        </nav>
      </details>
      <a
        href={REPO_URL}
        aria-label="Indent on GitHub"
        title="Indent on GitHub"
        class="inline-flex size-9 shrink-0 items-center justify-center rounded-full border border-border text-muted-foreground transition-colors hover:bg-accent hover:text-foreground"
      >
        <svg viewBox="0 0 24 24" class="size-[18px]" fill="currentColor" aria-hidden="true">
          <path
            d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
          ></path>
        </svg>
      </a>
      <a
        href="#run"
        class="inline-flex h-9 shrink-0 items-center rounded-full bg-foreground px-4 text-[14px] whitespace-nowrap font-medium text-background transition-opacity hover:opacity-90"
      >
        Get Indent
      </a>
    </div>
  </div>
  <script>
    for (const menu of document.querySelectorAll<HTMLDetailsElement>('.nav-menu')) {
      menu.addEventListener('click', (event) => {
        if ((event.target as HTMLElement).closest('a')) menu.open = false
      })
    }
  </script>
</header>
