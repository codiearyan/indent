---
import { Image } from 'astro:assets'
import logo from '@indent/design/logo.png'

const links = [
  { href: '#repos', label: 'Repos' },
  { href: '#how', label: 'How it works' },
  { href: '#local', label: 'Local first' },
  { href: '#patterns', label: 'Patterns' },
  { href: '#faq', label: 'FAQ' }
]
---

<header class="absolute inset-x-0 top-0 z-20">
  <div class="wrap flex h-20 items-center justify-between gap-4">
    <a href="#top" class="flex items-center gap-2.5 rounded-md" aria-label="Indent, back to top">
      <Image src={logo} alt="" width={56} height={56} class="size-7 rounded-md" loading="eager" />
      <span class="text-[17px] font-semibold tracking-[-0.01em]">Indent</span>
    </a>
    <nav
      aria-label="Sections"
      class="absolute left-1/2 hidden h-11 -translate-x-1/2 items-center rounded-full border border-border bg-background px-1.5 lg:flex"
    >
      {
        links.map((link) => (
          <a
            href={link.href}
            class="rounded-full px-4 py-1.5 text-[14px] text-muted-foreground transition-colors hover:bg-accent hover:text-foreground"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="flex items-center gap-2">
      <details class="nav-menu relative lg:hidden">
        <summary
          class="inline-flex h-9 cursor-pointer items-center rounded-full border border-border px-4 text-[14px] text-muted-foreground hover:text-foreground"
        >
          Menu
        </summary>
        <nav
          aria-label="Sections"
          class="absolute right-0 mt-2 w-52 rounded-lg border border-border bg-popover p-1.5 shadow-2xl"
        >
          {
            links.map((link) => (
              <a
                href={link.href}
                class="block rounded-md px-3 py-2.5 text-[14px] text-muted-foreground hover:bg-accent hover:text-foreground"
              >
                {link.label}
              </a>
            ))
          }
        </nav>
      </details>
      <a
        href="#run"
        class="inline-flex h-9 items-center rounded-full bg-foreground px-4 text-[14px] font-medium text-background transition-opacity hover:opacity-90"
      >
        Get Indent
      </a>
    </div>
  </div>
  <script>
    for (const menu of document.querySelectorAll<HTMLDetailsElement>('.nav-menu')) {
      menu.addEventListener('click', (event) => {
        if ((event.target as HTMLElement).closest('a')) menu.open = false
      })
    }
  </script>
</header>
