---
import SectionHead from './SectionHead.astro'

const steps = [
  {
    title: 'Read the lesson',
    body: 'Who runs the company, what they need and what you need to know. It reads itself aloud if you would rather listen.'
  },
  {
    title: 'Write the code',
    body: 'The files open in a real editor, in a folder on your disk. You write the function the issue asks for.'
  },
  {
    title: 'Run it',
    body: 'A real shell sits under the editor, already in your workspace. Use node, git or anything you have installed.'
  },
  {
    title: 'Press Check',
    body: 'Hidden tests run against your code. Each task turns green, or says in plain words what to look at.'
  }
]
---

<section id="loop" aria-labelledby="loop-title" class="scroll-mt-8 border-t border-rule py-28 sm:py-40">
  <div class="wrap">
    <SectionHead
      id="loop-title"
      label="/how it works"
      step={3}
      muted="One issue, four moves."
      bright="The same loop you use at work."
    />

    <ol class="mt-16 grid overflow-hidden rounded-lg border border-border sm:grid-cols-2 lg:grid-cols-4">
      {
        steps.map((step, i) => (
          <li
            class:list={[
              'flex flex-col p-6 sm:p-8',
              i > 0 && 'border-t border-rule',
              i % 2 === 1 && 'sm:border-l',
              i === 1 && 'sm:border-t-0',
              i === 2 && 'lg:border-t-0 lg:border-l'
            ]}
          >
            <span class="font-mono text-[40px] leading-none tracking-[-0.04em] text-muted-foreground/60 tabular-nums">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="headline mt-8 text-[24px]">{step.title}</h3>
            <p class="mt-3 text-[15px] leading-[1.6] text-pretty text-muted-foreground">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
