<section
  id="roadmaps"
  aria-labelledby="roadmaps-title"
  class="scroll-mt-8 border-t border-rule py-28 sm:py-40"
>
  <div class="wrap">
    <SectionHead
      id="roadmaps-title"
      label="/roadmaps"
      step={4}
      muted="Not sure where to start?"
      bright="Pick a roadmap."
    />

    <ul class="mt-16 rounded-lg border border-border">
      {
        roadmaps.map((roadmap) => (
          <li class="grid gap-3 border-b border-rule px-6 py-5 last:border-b-0 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center sm:gap-8 sm:px-8">
            <div>
              <h3 class="text-[17px] font-medium tracking-[-0.01em]">{roadmap.title}</h3>
              <p class="mt-1 text-[14px] leading-[1.5] text-muted-foreground">{roadmap.tagline}</p>
            </div>
            <p class="font-mono text-[12px] text-muted-foreground tabular-nums sm:text-right">
              {roadmap.stages} stages, {roadmap.repos} repos
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<section
  id="activity"
  aria-labelledby="activity-title"
  class="scroll-mt-8 border-t border-rule py-28 sm:py-40"
>
  <div class="wrap">
    <SectionHead
      id="activity-title"
      label="/activity"
      step={5}
      muted="Progress you can see."
      bright="Points, levels and a streak, kept honest by the tests."
    />

    <div class="mt-16 rounded-[18px] border border-border bg-card p-1.5">
      <Shot
        src={activity}
        alt="The activity board for the year: a heatmap of days with a few orange squares in November, and below it points this year, tasks passed, active days, current streak, longest streak and level."
        crop={[560, 240, 2210, 680]}
        maxWidth={1180}
        class="hidden rounded-[13px] sm:block"
      />
      <Shot
        src={activity}
        alt="The last months of the activity board, with a few orange squares in November, and the points, tasks and streak figures below."
        crop={[1640, 250, 1120, 640]}
        maxWidth={640}
        class="rounded-[11px] sm:hidden"
      />
    </div>

    <ul class="mt-6 grid gap-px overflow-hidden rounded-lg border border-border bg-border md:grid-cols-3">
      {
        keepUp.map((item) => (
          <li class="bg-background p-6 sm:p-8">
            <h3 class="text-sm font-semibold">{item.title}</h3>
            <p class="mt-2 text-[15px] leading-[1.6] text-muted-foreground">{item.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
