---
import type { Repo } from '../lib/content'
import { MAX_HINTS } from '../../../desktop/src/shared/rules'
import BuildStrip from './BuildStrip.astro'
import Shot from './Shot.astro'
import TutorDemo from './TutorDemo.astro'
import workspace from '../assets/screens/workspace.png'

interface Props {
  repos: Repo[]
}

const { repos } = Astro.props
const count = (n: number): string => n.toLocaleString('en-US')
const figures = [
  { label: 'Repos', value: repos.length },
  { label: 'Issues', value: repos.reduce((n, r) => n + r.issues.length, 0) },
  { label: 'Tasks', value: repos.reduce((n, r) => n + r.tasks, 0) }
]
const kinds = [
  { label: 'Foundations', kind: 'foundations' },
  { label: 'Projects', kind: 'project' },
  { label: 'Bug hunts', kind: 'bug-hunt' }
].map((k) => ({ ...k, value: repos.filter((r) => r.kind === k.kind).length }))
---

<section id="how" aria-labelledby="how-title" class="scroll-mt-8 py-28 sm:py-40">
  <div class="wrap">
    <h2 id="how-title" class="display max-w-[1100px] text-[44px] text-balance sm:text-[72px] lg:text-[96px]">
      <span class="text-muted-foreground">Everyone says learn with AI.</span>{' '}
      <span>Nobody says how.</span>
    </h2>
    <p class="headline mt-8 text-[28px] text-brand sm:text-[36px]">Here's how.</p>

    <ol class="mt-16 border-t border-rule sm:mt-24">
      <li class="grid items-center gap-10 border-b border-rule py-16 sm:py-24 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <span class="font-mono text-[13px] text-muted-foreground">01 Real problems</span>
          <h3 class="headline mt-6 text-[30px] text-balance sm:text-[40px]">
            {repos.length} small companies with a problem. You are the developer they just hired.
          </h3>
          <p class="mt-5 max-w-[460px] text-[17px] leading-[1.6] text-pretty text-muted-foreground">
            Every issue starts with someone whose order total is off by a cent or whose server will
            not answer. You open code you did not write and make it right.
          </p>
        </div>
        <div class="lg:col-span-7">
          <dl class="grid grid-cols-3 rounded-lg border border-border">
            {
              figures.map((figure, i) => (
                <div class:list={['flex flex-col gap-3 p-5 sm:p-8', i > 0 && 'border-l border-rule']}>
                  <dt class="text-[13px] text-muted-foreground">{figure.label}</dt>
                  <dd class="text-[32px] leading-none tracking-[-0.03em] tabular-nums sm:text-[56px]">
                    {count(figure.value)}
                  </dd>
                </div>
              ))
            }
            {
              kinds.map((k, i) => (
                <div class:list={['flex items-baseline justify-between gap-2 border-t border-rule px-5 py-4 sm:px-8', i > 0 && 'border-l']}>
                  <dt class="text-[13px] text-muted-foreground sm:text-[14px]">{k.label}</dt>
                  <dd class="font-mono text-[13px] tabular-nums">{k.value}</dd>
                </div>
              ))
            }
          </dl>
          <p class="mt-4 text-[13px] text-muted-foreground">
            Learn a language from the start, build one real thing over a few issues, or hunt the bugs
            an interview would ask about.
          </p>
        </div>
      </li>

      <li class="grid items-center gap-10 border-b border-rule py-16 sm:py-24 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <span class="font-mono text-[13px] text-muted-foreground">02 A real IDE</span>
          <h3 class="headline mt-6 text-[30px] text-balance sm:text-[40px]">
            A real editor, a real terminal, and tests you can't see.
          </h3>
          <p class="mt-5 max-w-[460px] text-[17px] leading-[1.6] text-pretty text-muted-foreground">
            Your files are a folder on disk. Run them with node, or open them in your own IDE, then
            press Check: hidden tests turn each task green or say what to look at.
          </p>
        </div>
        <div class="lg:col-span-7">
          <div class="rounded-[18px] border border-border bg-card p-1.5">
            <Shot
              src={workspace}
              crop={[1100, 100, 1770, 1690]}
              alt="The editor with src/respond.js open above a terminal where node try.js answers GET /health with 200, GET /canoes with 404 and DELETE /boats with 405."
              maxWidth={700}
              class="rounded-[13px]"
            />
          </div>
        </div>
      </li>

      <li class="grid items-center gap-10 py-16 sm:py-24 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <span class="font-mono text-[13px] text-muted-foreground">03 AI that teaches</span>
          <h3 class="headline mt-6 text-[30px] text-balance sm:text-[40px]">
            A tutor that draws the idea and leaves the code to you.
          </h3>
          <p class="mt-5 max-w-[460px] text-[17px] leading-[1.6] text-pretty text-muted-foreground">
            Ask about a failed check or a line you selected. It answers with a diagram of how the
            pieces connect, steps to walk through, or a quick quiz.
          </p>
          <p class="mt-8 flex flex-col gap-3 text-[14px] text-muted-foreground">
            <BuildStrip groups={[MAX_HINTS]} filled={1} size="md" />
            {MAX_HINTS} hints per task open one at a time, from a nudge to almost there.
          </p>
        </div>
        <div class="lg:col-span-7">
          <TutorDemo />
        </div>
      </li>
    </ol>
  </div>
</section>
