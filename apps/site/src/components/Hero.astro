---
import ChevronDown from '@lucide/astro/icons/chevron-down'
import Download from '@lucide/astro/icons/download'
import { DOWNLOADS, RELEASES_URL, REPO_URL, VERSION } from '../lib/downloads'
import CodeTexture from './CodeTexture.astro'
import OsIcons from './OsIcons.astro'
import Pause from '@lucide/astro/icons/pause'
import Play from '@lucide/astro/icons/play'

const SYSTEMS = ['mac', 'windows', 'linux'] as const
---

<OsIcons />

<section id="top" aria-labelledby="hero-title" class="relative pt-36 sm:pt-44">
  <CodeTexture />
  <div class="wrap relative flex flex-col items-center text-center">
    <p
      class="inline-flex items-center gap-2.5 rounded-full border border-border bg-background py-1 pr-4 pl-1 text-[14px] text-muted-foreground"
    >
      <span class="rounded-full bg-primary px-2.5 py-0.5 text-[13px] font-medium text-primary-foreground">
        v{VERSION}
      </span>
      A desktop app. No account, no server.
    </p>
    <h1
      id="hero-title"
      class="display mt-8 max-w-[1100px] text-[44px] text-balance sm:text-[72px] lg:text-[104px]"
    >
      Learn to code by fixing real problems
    </h1>
    <p
      class="mt-7 max-w-[620px] text-[17px] leading-[1.6] text-balance text-muted-foreground sm:text-[19px]"
    >
      Each repo is a small company with a problem, and you are its developer. Write the fix in a
      real editor, run it in a real terminal, press Check.
    </p>
    <div class="mt-10 flex w-full flex-col items-center justify-center gap-3 sm:w-auto sm:flex-row">
      <div class="relative flex h-13 w-full sm:w-auto">
        <a
          href={DOWNLOADS[0].href}
          data-download-main
          class="inline-flex h-full flex-1 items-center justify-center gap-2.5 rounded-l-full bg-primary pr-5 pl-7 text-[16px] font-medium text-primary-foreground transition-opacity hover:opacity-90"
        >
          {
            SYSTEMS.map((os) => (
              <span data-download-icon={os} hidden={os !== DOWNLOADS[0].os}>
                <svg class="size-[18px]" fill="currentColor" aria-hidden="true">
                  <use href={`#os-${os}`} />
                </svg>
              </span>
            ))
          }
          <span data-download-icon="none" hidden>
            <Download class="size-4" stroke-width={2} aria-hidden="true" />
          </span>
          <span data-download-label>{DOWNLOADS[0].button}</span>
        </a>
        <details class="group h-full" data-download-menu>
          <summary
            aria-label="All downloads"
            class="flex h-full w-12 cursor-pointer list-none items-center justify-center rounded-r-full border-l border-primary-foreground/25 bg-primary text-primary-foreground transition-opacity hover:opacity-90 [&::-webkit-details-marker]:hidden"
          >
            <ChevronDown
              class="size-4 transition-transform group-open:rotate-180"
              stroke-width={2}
              aria-hidden="true"
            />
          </summary>
          <ul
            class="absolute top-full left-0 z-20 mt-2 w-full rounded-2xl border border-border bg-popover p-1.5 text-left shadow-2xl sm:w-[330px]"
          >
            {
              DOWNLOADS.map((download) => (
                <li>
                  <a
                    href={download.href}
                    data-download-id={download.id}
                    data-download-os={download.os}
                    data-download-button={download.button}
                    class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-[15px] hover:bg-accent"
                  >
                    <svg class="size-[18px] shrink-0" fill="currentColor" aria-hidden="true">
                      <use href={`#os-${download.os}`} />
                    </svg>
                    <span class="font-medium">{download.name}</span>
                    <span class="ml-auto text-[14px] text-muted-foreground">{download.detail}</span>
                  </a>
                </li>
              ))
            }
            <li class="mt-1.5 border-t border-border pt-1.5">
              <a
                href={RELEASES_URL}
                class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-[15px] hover:bg-accent"
              >
                <span class="w-[18px]"></span>
                <span class="font-medium">All downloads</span>
              </a>
            </li>
          </ul>
        </details>
      </div>
      <a
        href={REPO_URL}
        class="inline-flex h-13 w-full items-center justify-center gap-2.5 rounded-full border border-input px-7 text-[16px] font-medium transition-colors hover:bg-accent sm:w-auto"
      >
        <svg viewBox="0 0 24 24" class="size-[18px]" fill="currentColor" aria-hidden="true">
          <path
            d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
          ></path>
        </svg>
        Star on GitHub
      </a>
    </div>
  </div>

  <div class="relative mx-auto mt-20 w-full max-w-[1400px] px-3 sm:mt-24 sm:px-8">
    <div class="brand-halo pointer-events-none absolute inset-x-0 top-0 -bottom-24" aria-hidden="true">
    </div>
    <figure class="relative">
      <div class="relative rounded-[22px] border border-border bg-card p-1.5 shadow-2xl sm:p-2">
        <video
          class="block aspect-[16/10] w-full rounded-[12px] bg-background sm:rounded-[16px]"
          autoplay
          muted
          loop
          playsinline
          preload="auto"
          poster="/video/hero-poster.jpg"
          aria-label="An issue in Indent from start to finish: the story plays, code is written in the editor and run in the terminal, a check fails with a plain message, the tutor draws a diagram, every task turns green, and the tutor switches to another AI."
          data-hero-video
        >
          <source src="/video/hero.webm" type="video/webm" />
          <source src="/video/hero.mp4" type="video/mp4" />
        </video>
        <button
          type="button"
          class="absolute right-4 bottom-4 inline-flex size-9 items-center justify-center rounded-full border border-border bg-popover text-muted-foreground transition-colors hover:text-foreground sm:right-6 sm:bottom-6"
          aria-label="Pause the video"
          data-hero-toggle
        >
          <span data-icon="pause"><Pause class="size-4" stroke-width={1.5} aria-hidden="true" /></span>
          <span data-icon="play" hidden><Play class="size-4" stroke-width={1.5} aria-hidden="true" /></span>
        </button>
      </div>
      <figcaption class="sr-only">One issue in Indent, from the story to every task passing.</figcaption>
    </figure>
  </div>
</section>

<script>
  // The page is built with the Apple Silicon download in the main button. This swaps in the
  // download for the visitor's own system; the menu beside it always lists every download.
  type Id = 'mac-arm64' | 'mac-x64' | 'windows' | 'linux'

  async function detect(): Promise<Id | null> {
    const data = (navigator as Navigator & { userAgentData?: UserAgentData }).userAgentData
    const platform = (data?.platform || navigator.platform || '').toLowerCase()
    const phone = /android|iphone|ipad|ipod/i.test(navigator.userAgent)
    // An iPad says it is a Mac, but a Mac has no touch screen.
    if (data?.mobile || phone || (platform.includes('mac') && navigator.maxTouchPoints > 1)) {
      return null
    }
    if (platform.includes('win')) return 'windows'
    if (platform.includes('linux')) return 'linux'
    if (!platform.includes('mac')) return null
    // Only Chromium browsers say which chip a Mac has; the others get Apple Silicon.
    const chip = await data
      ?.getHighEntropyValues?.(['architecture'])
      .then((values) => values.architecture)
      .catch(() => undefined)
    return chip === 'x86' ? 'mac-x64' : 'mac-arm64'
  }

  interface UserAgentData {
    platform?: string
    mobile?: boolean
    getHighEntropyValues?(hints: string[]): Promise<{ architecture?: string }>
  }

  const main = document.querySelector<HTMLAnchorElement>('[data-download-main]')
  const label = document.querySelector<HTMLElement>('[data-download-label]')
  const menu = document.querySelector<HTMLDetailsElement>('[data-download-menu]')

  function show(icon: string): void {
    for (const el of document.querySelectorAll<HTMLElement>('[data-download-icon]')) {
      el.toggleAttribute('hidden', el.dataset.downloadIcon !== icon)
    }
  }

  void detect().then((id) => {
    if (!main || !label) return
    const mine = id && menu?.querySelector<HTMLAnchorElement>(`[data-download-id="${id}"]`)
    if (!mine) {
      // A phone or a system with no build: point at the list of downloads instead.
      main.href = '#run'
      label.textContent = 'Get Indent'
      show('none')
      return
    }
    main.href = mine.href
    label.textContent = mine.dataset.downloadButton ?? label.textContent
    show(mine.dataset.downloadOs ?? 'none')
  })

  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]')
  const toggle = document.querySelector<HTMLButtonElement>('[data-hero-toggle]')
  function showPlaying(playing: boolean): void {
    if (!toggle) return
    toggle.setAttribute('aria-label', playing ? 'Pause the video' : 'Play the video')
    toggle.querySelector('[data-icon="pause"]')?.toggleAttribute('hidden', !playing)
    toggle.querySelector('[data-icon="play"]')?.toggleAttribute('hidden', playing)
  }
  if (video) {
    // Reduced motion keeps the poster until the visitor asks for the video.
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      video.removeAttribute('autoplay')
      video.pause()
    }
    video.addEventListener('play', () => showPlaying(true))
    video.addEventListener('pause', () => showPlaying(false))
    showPlaying(!video.paused || video.autoplay)
    toggle?.addEventListener('click', () => void (video.paused ? video.play() : video.pause()))
  }

  if (menu) {
    const close = (): void => void (menu.open = false)
    document.addEventListener('click', (event) => {
      const target = event.target as Node
      // Outside the menu, or on one of its links: either way the menu is done.
      if (!menu.contains(target) || (target as HTMLElement).closest?.('a')) close()
    })
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        close()
        menu.querySelector('summary')?.focus()
      }
    })
  }
</script>
