---
import Download from '@lucide/astro/icons/download'
import { DOWNLOADS, REPO_URL, VERSION } from '../lib/downloads'
import CodeTexture from './CodeTexture.astro'
import Shot from './Shot.astro'
import workspace from '../assets/screens/workspace.png'

interface Props {
  repos: number
  issues: number
  tasks: number
}

const { repos, issues, tasks } = Astro.props
---

<section id="top" aria-labelledby="hero-title" class="relative pt-36 sm:pt-44">
  <CodeTexture />
  <div class="wrap relative flex flex-col items-center text-center">
    <p
      class="inline-flex items-center gap-2.5 rounded-full border border-border bg-background py-1 pr-4 pl-1 text-[14px] text-muted-foreground"
    >
      <span class="rounded-full bg-primary px-2.5 py-0.5 text-[13px] font-medium text-primary-foreground">
        v{VERSION}
      </span>
      A desktop app. No account, no server.
    </p>
    <h1
      id="hero-title"
      class="display mt-8 max-w-[1100px] text-[44px] text-balance sm:text-[72px] lg:text-[104px]"
    >
      Learn to code by fixing real problems
    </h1>
    <p
      class="mt-7 max-w-[640px] text-[17px] leading-[1.6] text-balance text-muted-foreground sm:text-[19px]"
    >
      Each repo is a small company with a problem, and you are its developer. Read a short lesson,
      write the code in a real editor, run it in a real terminal, and press Check.
    </p>
    <div class="mt-10 flex w-full flex-col items-center justify-center gap-3 sm:w-auto sm:flex-row">
      <a
        href={DOWNLOADS[0].href}
        data-download-main
        class="inline-flex h-13 w-full items-center justify-center gap-2.5 rounded-full bg-primary px-7 text-[16px] font-medium text-primary-foreground transition-opacity hover:opacity-90 sm:w-auto"
      >
        <Download class="size-4" stroke-width={2} aria-hidden="true" />
        <span data-download-label>{DOWNLOADS[0].button}</span>
      </a>
      <a
        href={REPO_URL}
        class="inline-flex h-13 w-full items-center justify-center gap-2.5 rounded-full border border-input px-7 text-[16px] font-medium transition-colors hover:bg-accent sm:w-auto"
      >
        <svg viewBox="0 0 24 24" class="size-[18px]" fill="currentColor" aria-hidden="true">
          <path
            d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
          ></path>
        </svg>
        View on GitHub
      </a>
    </div>
    <ul
      class="mt-5 flex flex-wrap items-center justify-center gap-x-5 gap-y-1 text-[14px] text-muted-foreground"
      aria-label="Other downloads"
    >
      <li data-download-also>Also for</li>
      {
        DOWNLOADS.map((download, i) => (
          <li hidden={i === 0} data-download-id={download.id} data-download-button={download.button}>
            <a
              href={download.href}
              class="text-foreground underline decoration-border underline-offset-4 hover:decoration-foreground"
            >
              {download.label}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="mt-5 text-[14px] text-muted-foreground tabular-nums">
      <span class="text-foreground">{repos}</span> repos,{' '}
      <span class="text-foreground">{issues}</span> issues,{' '}
      <span class="text-foreground">{tasks}</span> tasks. All of it on your disk.
    </p>
  </div>

  <div class="relative mx-auto mt-20 w-full max-w-[1400px] px-3 sm:mt-24 sm:px-8">
    <div class="brand-halo pointer-events-none absolute inset-x-0 top-0 -bottom-24" aria-hidden="true">
    </div>
    <figure class="relative">
      <div
        class="absolute -top-5 right-4 z-10 flex items-center gap-2.5 rounded-full border border-border bg-popover py-2 pr-4 pl-3 text-[14px] shadow-2xl sm:right-10"
      >
        <span class="size-2 rounded-full bg-success" aria-hidden="true"></span>
        <span class="text-foreground">3 of 3 tasks pass</span>
        <span class="hidden text-muted-foreground sm:inline">Issue 1 of 5</span>
      </div>
      <div class="rounded-[22px] border border-border bg-card p-1.5 shadow-2xl sm:p-2">
        <Shot
          src={workspace}
          alt="The Indent workspace. On the left, the tasks of the issue A server that answers, all three passed. In the middle, src/respond.js in the editor. Below, the terminal shows node try.js answering GET /health, GET /boats, a 404 and a 405."
          maxWidth={1340}
          eager
          class="hidden rounded-[16px] sm:block"
        />
        <Shot
          src={workspace}
          crop={[0, 70, 1300, 1300]}
          alt="The Indent workspace: the tasks of the issue A server that answers, all three passed, next to src/respond.js in the editor."
          maxWidth={640}
          class="rounded-[12px] sm:hidden"
        />
      </div>
      <figcaption class="sr-only">The workspace after every task of an issue has passed.</figcaption>
    </figure>
  </div>
</section>

<script>
  // The page is built with the Apple Silicon download in the main button. This swaps in the
  // download for the visitor's own system and lists the other three next to it.
  type Id = 'mac-arm64' | 'mac-x64' | 'windows' | 'linux'

  async function detect(): Promise<Id | null> {
    const data = (navigator as Navigator & { userAgentData?: UserAgentData }).userAgentData
    const platform = (data?.platform || navigator.platform || '').toLowerCase()
    const phone = /android|iphone|ipad|ipod/i.test(navigator.userAgent)
    // An iPad says it is a Mac, but a Mac has no touch screen.
    if (data?.mobile || phone || (platform.includes('mac') && navigator.maxTouchPoints > 1)) {
      return null
    }
    if (platform.includes('win')) return 'windows'
    if (platform.includes('linux')) return 'linux'
    if (!platform.includes('mac')) return null
    // Only Chromium browsers say which chip a Mac has; the others get Apple Silicon.
    const chip = await data
      ?.getHighEntropyValues?.(['architecture'])
      .then((values) => values.architecture)
      .catch(() => undefined)
    return chip === 'x86' ? 'mac-x64' : 'mac-arm64'
  }

  interface UserAgentData {
    platform?: string
    mobile?: boolean
    getHighEntropyValues?(hints: string[]): Promise<{ architecture?: string }>
  }

  const main = document.querySelector<HTMLAnchorElement>('[data-download-main]')
  const label = document.querySelector<HTMLElement>('[data-download-label]')
  const others = [...document.querySelectorAll<HTMLElement>('[data-download-id]')]

  void detect().then((id) => {
    if (!main || !label) return
    if (!id) {
      // A phone or a system with no build: point at the list of downloads instead.
      main.href = '#run'
      label.textContent = 'Get Indent'
      for (const item of others) item.hidden = false
      document.querySelector('[data-download-also]')?.replaceChildren('Downloads for')
      return
    }
    for (const item of others) {
      const mine = item.dataset.downloadId === id
      item.hidden = mine
      if (mine) {
        main.href = item.querySelector('a')!.href
        label.textContent = item.dataset.downloadButton ?? label.textContent
      }
    }
  })
</script>
